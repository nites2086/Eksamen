CREATE TABLE Sykler(
  sykkel_id INT PRIMARY KEY,

  Status TEXT NOT NULL
  CHECK(
      status IN (
          'Aktiv',
          'På verksted',
          'Stjålet'
      )
  ),
  sist_vedlikeholdt DATE
);

CREATE TABLE Stasjoner(
  stasjon_id INT PRIMARY KEY,
  navn VARCHAR(100) NOT NULL,

  kapasitet INT NOT NULL
  CHECK(kapasitet > 0),

  lat DECIMAL(9,6),
  lon DECIMAL(9,6)

);

CREATE TABLE Brukere(
  bruker_id INT PRIMARY KEY,
  navn VARCHAR(100) NOT NULL,
  telefon VARCHAR(20),
  betalingsmetode VARCHAR(50)

);


CREATE TABLE Utleier_turer(
  tur_id INT PRIMARY KEY,
  sykkel_id INT NOT NULL,
  bruker_id INT NOT NULL,
  start_stasjon VARCHAR(100),
  slutt_stasjon VARCHAR(100),
  start_tid TIMESTAMP NOT NULL,
  slutt_tid TIMESTAMP,
  pris DECIMAL(2,8),

  FOREIGN KEY (sykkel_id)
    REFERENCES Sykler(sykkel_id),

  FOREIGN KEY (bruker_id)
    REFERENCES Bruker(bruker_id),

  FOREIGN KEY (start_stasjon)
    REFERENCES Stasjoner(stasjon_id),

  FOREIGN KEY (slutt_stasjon)
    REFERENCES Stasjoner(stasjon_id)
);


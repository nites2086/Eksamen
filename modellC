# Oppgave 30

CREATE TABLE Avdelinger(
  avdeling_id INT PRIMARY KEY,
  navn VARCHAR(100) NOT NULL,
  leder_id INT);

CREATE TABLE Ansatte(
  ansatt_id INT PRIMARY KEY,
  navn VARCHAR(100) NOT NULL,
  avdeling_id INT,
  ansettelsesdato DATE NOT NULL

  FOREIGN KEY(avdeling_id)
    REFERENCES Avdelinger(avdeling_id)
);

CREATE TABLE Prosjekter(
  prosjekt_id INT PRIMARY KEY,
  navn VARCHAR(100) NOT NULL,
  budsjett DECIMAL(12,2) NOT NULL CHECK (budsjett >= 0),
  start_dato DATE NOT NULL,
  slutt_dato DATE,

  CHECK(slutt_dato IS NULL OR slutt_dato >= start_dato)
);

CREATE TABLE Prosjektdeltakelse(
  ansatt_id INT NOT NULL,
  prosjekt_id INT NOT NULL,
  rolle VARCHAR(100),
  timer_allokert INT NOT NULL CHECK(timer_allokert >= 0)

  PRIMARY KEY(ansatt_id,prosjekt_id)

  FOREIGN KEY(ansatt_id)
    REFERENCES Ansatte(ansatt_id),

  FOREIGN KEY(prosjekt_id)
    REFERENCES Prosjekter(prosjekt_id)
);


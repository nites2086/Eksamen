'Oppgave 32'


CREATE TABLE Spillere(
  spiller_id INT PRIMARY KEY,
  brukernavn TEXT NOT NULL UNIQUE,
  region TEXT NOT NULL,
  rank TEXT
);

CREATE TABLE Turneringer(
  turnering_id INT PRIMARY KEY,
  navn TEXT NOT NULL,
  start_dato DATE NOT NULL,
  premirepott DECIMAL(12,2) CHECK(premiepott >= 0)
);

CREATE TABLE Lop(
  lop_id INT PRIMARY KEY,
  turnering_id INT NOT NULL,
  bane_navn TEXT NOT NULL,
  vaerforhold TEXT,

  FOREIGN KEY (turnering_id)
    REFERENCES Turneringer(turnering_id)
);

CREATE TABLE Deltakelser(
  spiller_id INT NOT NULL,
  lop_id INT NOT NULL,
  plasseringer INT CHECK(plasseringer > 0),
  beste_rundetid INTERVAL,

  PRIMARY KEY(spiller_id,lop_id),

  FOREIGN KEY (spiller_id)
    REFERENCES Spillere(spiller_id),

   FOREIGN KEY (lop_id)
    REFERENCES Lop(lop_id)
);



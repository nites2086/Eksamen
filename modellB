SELECT SUM(premiepott) AS totale_premiepotten
FROM Turneringer
WHERE start_dato >= '2025-01-01'
AND start_dato < '2026-01-01';


' Oppgave 51 '
Hvordan bruker du en vekselvirkende delspørring (se pensumboken side 127 5. utgave) 
for å finne den beste rundetid for hver spiller på tvers av alle løp? Gjelder Modell B (E-sport).

SELECT s.brukernavn, l.lop_id, d.beste_rundetid
FROM Spillere s
JOIN Deltakelser d
ON s.spiller_id = d.spiller_id
JOIN Lop l
ON d.lop_id = l.lop_id

WHERE d.beste_rundetid = (
SELECT MIN(d2.beste_rundetid)
FROM Deltakelser d2
WHERE d2.spiller_id = d.spiller_id
);



' Oppgave 53 '
Skriv en vindusfunksjon-spørring som rangerer (RANK()) spillere basert på deres beste_rundetid 
i et spesifikt løp. Gjelder Modell B (E-sport).

SELECT s.brukernavn AS navn, d.beste_rundetid
 RANK() OVER (
        ORDER BY d.beste_rundetid ASC
    ) AS plassering
FROM Spillere s

JOIN Deltakelser d
ON s.spiller_id = d.spiller_id

WHERE d.loop_id = 1000;


' Oppgave 59 '


CREATE MATERIALIZED VIEW mv_turneringer_ledertavle AS
SELECT 
t.turnering_id, 
t.navn AS turnering_navn, 
s.spiller_id, 
s.brukernavn, 
COUNT(l.lop_id) AS lop_i_turnering,
AVG(d.plasseringer) AS snitt_plassering, 

MIN(d.beste_rundetid) AS beste_tid_i_rundetid,
RANK() OVER (
PARTITION BY t.turnering_id
ORDER BY AVG(d.plasseringer)) AS rang_i_turnering


FROM Turneringer t

JOIN Lop l
ON t.turnering_id = l.turnering_id

JOIN Deltakelser d
ON l.lop_id = d.lop_id

JOIN Spillere s
ON d.spiller_id = s.spiller_id

GROUP BY t.turnering_id, t.navn, s.spiller_id, s.brukernavn;



